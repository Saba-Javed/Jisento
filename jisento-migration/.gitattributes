# Normalize text files to LF in the repository and working tree.
* text=auto eol=lf

# Keep binary assets binary (no line-ending conversion).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mo binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
